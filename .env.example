# Payments. Default is "venue": players pay at the venue counter, nothing is charged online.
# Set PAYMENT_MODE=razorpay together with the keys below to switch to online payments.
# PAYMENT_MODE=venue

# Razorpay (https://dashboard.razorpay.com → Settings → API Keys). Only used when PAYMENT_MODE=razorpay.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
# Settings → Webhooks → add https://<your-domain>/api/payments/webhook with events
# payment.captured, payment.failed, refund.processed, refund.failed, and this secret.
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxx

# SMS OTP provider key. Leave unset to use the fixed demo OTP (123456, or PLAYVTH_DEMO_OTP).
# SMS_API_KEY=
# PLAYVTH_DEMO_OTP=123456

# Optional: where the SQLite file lives (default ./data/playvth.db)
# PLAYVTH_DB_PATH=

# WhatsApp alerts via the Meta WhatsApp Cloud API (https://developers.facebook.com/docs/whatsapp/cloud-api).
# Leave unset and alerts are written to the in-app Alerts log only (visible in the partner dashboard).
# WHATSAPP_TOKEN=            # permanent System User access token
# WHATSAPP_PHONE_NUMBER_ID=  # the sending number's Phone Number ID
# WHATSAPP_MODE=text         # "text" (free-form, works inside the 24h customer window / test numbers) or "template" (approved templates, required for business-initiated messages at scale)
# WHATSAPP_TEMPLATE_LANG=en
# WHATSAPP_TEMPLATE_VENUE_BOOKED=playvth_venue_booked         # params: venue, customer, phone, court, date, time, amount, code
# WHATSAPP_TEMPLATE_VENUE_CANCELLED=playvth_venue_cancelled   # params: venue, customer, court, date, time, code
# WHATSAPP_TEMPLATE_PLAYER_CONFIRMED=playvth_player_confirmed # params: name, venue, court, date, time, amount, code
# WHATSAPP_TEMPLATE_PLAYER_CANCELLED=playvth_player_cancelled # params: name, venue, date, time, code

# Where uploaded venue photos are stored (default: next to the SQLite file, e.g. /data/uploads on Railway)
# PLAYVTH_UPLOAD_DIR=
